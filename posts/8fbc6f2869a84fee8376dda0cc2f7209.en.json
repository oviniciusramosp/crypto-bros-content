    },
    {
      "type": "p",
      "spans": [
        {
          "text": "The second comes from "
        },
        {
          "text": "CryptoQuant",
          "bold": true
        },
        {
          "text": ", which points to the "
        },
        {
          "text": "$93,000",
          "bold": true,
          "color": "green"
        },
        {
          "text": " region as the main upside target for the current cycle, based on on-chain flow and custody metrics."
